{
  "name": "pbe-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "migrate": "bun src/server/migrate.ts",
    "db:reset": "bun scripts/db-reset.ts",
    "db:seed": "bun scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "valtio": "^2.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.8.3",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "railway": "^3.19.0",
    "typescript": "^7.0.2"
  }
}
