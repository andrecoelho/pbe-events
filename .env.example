# Copy to .env and adjust. mise loads .env for every task; Bun also reads it on its own.

# Postgres connection string (Bun's `sql` reads POSTGRES_URL).
# This default matches the local container started by `mise run db` (docker-compose.yml).
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres

# Folder for uploaded images and other app data (a Railway volume in staging/production).
PBE_APP_DATA_PATH=./data

# Server Configuration
NODE_ENV=development

# `mise run db:seed:staging` reads the staging demo password from 1Password. To use a different item:
# SEED_DEMO_PASSWORD_REF=op://PBE/PBE staging demo/password
